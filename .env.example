SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: real email delivery for OTP codes (signup verification + password reset).
# If these are left unset, ShieldSense automatically falls back to "dev mode":
# the OTP code is printed to the server console AND returned in the API response
# so the app is still fully demoable without a mail server (great for judging tables).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
